{
  "name": "@johannes-lindgren/open-api-mapi",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build:ts": "openapi-typescript ./src/openapi.yml --output dist/index.d.ts",
    "build:redoc": "redocly build-docs ./src/openapi.yml"
  },
  "devDependencies": {
    "openapi-typescript": "^7.6.1",
    "typescript": "^5.8.2",
    "@redocly/cli": "^1.33.1"
  }
}
