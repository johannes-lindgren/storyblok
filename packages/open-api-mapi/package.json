{
  "name": "@johannes-lindgren/openapi",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "build:ts": "openapi-typescript ./src/openapi.yml --output dist/index.d.ts --export-type",
    "dev:redoc": "redocly preview-docs ./src/openapi.yml",
    "build:redoc": "redocly build-docs ./src/openapi.yml --output=docs/redoc/index.html"
  },
  "devDependencies": {
    "openapi-typescript": "^7.6.1",
    "typescript": "^5.8.2",
    "@redocly/cli": "^1.33.1"
  }
}
